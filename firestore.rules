rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'basdonsab@gmail.com' ||
        request.auth.token.email == 'chromebook160nb@gmail.com'
      );
    }

    // User profiles & wallets
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Users can update their own data, and referral bonuses can adjust referrer's balance, or admin can update
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Ad Links - public read so visitors and users can see active ads
    match /adLinks/{adLinkId} {
      allow read: if true;
      allow create: if isAuthenticated() || request.resource.data.id == 'seed-ad-1';
      allow update, delete: if isAuthenticated();
    }

    // Withdrawal requests
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (
        resource.data.uid == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Anti-abuse claim sessions
    match /claimSessions/{sessionId} {
      allow read, write: if isAuthenticated();
    }
  }
}
